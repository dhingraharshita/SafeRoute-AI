# ==========================================
# SafeRoute AI — Environment Configuration
# Copy this file to .env and configure your secrets
# ==========================================

# Flask Secret Key for session signing
SECRET_KEY=your-super-secret-random-key-here

# Optional: Google Gemini Generative AI API Key
# If omitted or left blank, SafeRoute AI runs in 100% deterministic local mode with zero latency.
GEMINI_API_KEY=

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: development / production
FLASK_ENV=development
